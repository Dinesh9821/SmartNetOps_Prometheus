# Existing inventory database (site_id is the primary key).
# Do not point this at a newly invented CMDB — use the production inventory.
DATABASE_URL=sqlite:////var/lib/smartnetops/inventory.db

# Optional: override SQL if column names differ from the U_* defaults.
# INVENTORY_SITE_SQL=
# INVENTORY_DEVICE_SQL=
# INVENTORY_SERVER_SQL=

# Vault / credential resolver. FastAPI fetches secrets; they never go to the UI or LLM.
VAULT_BACKEND=env
# ENV backend looks up: SSH_PASSWORD_<HOSTNAME> or SSH_PASSWORD_DEFAULT
VAULT_MASTER=

# LLM (provider-agnostic). Leave LLM_PROVIDER=none to keep raw output and skip parse.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
PROMPT_VERSION=1.0

# Collectors
NETMIKO_TIMEOUT=30
SSH_TIMEOUT=25
MAX_COLLECTOR_CONCURRENCY=8

# Peer service for incident correlation (network agent calling server tools)
SERVER_API_BASE_URL=http://127.0.0.1:8002
NETWORK_API_BASE_URL=http://127.0.0.1:8001

# Meraki Dashboard (optional; used when device vendor is meraki)
MERAKI_API_KEY=
MERAKI_BASE_URL=https://api.meraki.com/api/v1

# Raw capture store (audit / re-parse). Never writes passwords.
RAW_CAPTURE_DIR=./raw_captures
