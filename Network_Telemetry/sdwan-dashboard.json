{
  "uid": "sdwan-overlay",
  "title": "SD-WAN Overlay Dashboard",
  "description": "Viptela / Catalyst SD-WAN: WAN interfaces plus OMP, BFD and BGP session health. Same Region > Country > Site > Device hierarchy as the Meraki dashboards; site_id is the first two hostname tokens and hostnames containing SD are treated as routers.",
  "tags": [
    "sdwan",
    "viptela",
    "wan"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ],
    "time_options": [
      "10m",
      "30m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (region) (last_over_time(vmanage_site_devices_total[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (region) (last_over_time(vmanage_site_devices_total[24h])))",
          "refId": "var-region"
        },
        "regex": "/region=\"([^\"]+)\"/",
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "country",
        "label": "Country",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (country) (last_over_time(vmanage_site_devices_total{region=~\"$region\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (country) (last_over_time(vmanage_site_devices_total{region=~\"$region\"}[24h])))",
          "refId": "var-country"
        },
        "regex": "/country=\"([^\"]+)\"/",
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "site",
        "label": "Site ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (site_id) (last_over_time(vmanage_site_devices_total{region=~\"$region\", country=~\"$country\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (site_id) (last_over_time(vmanage_site_devices_total{region=~\"$region\", country=~\"$country\"}[24h])))",
          "refId": "var-site"
        },
        "regex": "/site_id=\"([^\"]+)\"/",
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (hostname) (last_over_time(vmanage_device_reachable{region=~\"$region\", country=~\"$country\", site_id=~\"$site\"}[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (hostname) (last_over_time(vmanage_device_reachable{region=~\"$region\", country=~\"$country\", site_id=~\"$site\"}[24h])))",
          "refId": "var-device"
        },
        "regex": "/hostname=\"([^\"]+)\"/",
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      }
    ]
  },
