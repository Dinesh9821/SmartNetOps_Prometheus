{
  "uid": "wan-dashboard",
  "title": "WAN Dashboard",
  "description": "WAN links across Meraki and Viptela. Throughput is always shown; utilisation appears where a contracted CIR (Meraki) or port speed (Viptela) is known. Capacity Unknown counts what is missing.",
  "tags": [
    "wan",
    "meraki",
    "viptela"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ],
    "time_options": [
      "10m",
      "30m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (region) (last_over_time(wan_link_bits_per_second[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (region) (last_over_time(wan_link_bits_per_second[24h])))",
          "refId": "var-region"
        },
        "regex": "/region=\"([^\"]+)\"/",
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "query_result(count by (source) (last_over_time(wan_link_bits_per_second[24h])))",
        "query": {
          "qryType": 3,
          "query": "query_result(count by (source) (last_over_time(wan_link_bits_per_second[24h])))",
          "refId": "var-source"
        },
        "regex": "/source=\"([^\"]+)\"/",
        "multi": false,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "allValue": ".*"
      }
    ]
  },
