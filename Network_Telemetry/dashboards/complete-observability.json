    {
      "id": 10,
      "type": "table",
      "title": "Devices in scope \u2014 Meraki and Viptela",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every device at the selected scope from both systems. Managed By shows which platform owns it. Serial / System-IP is the vendor's own identifier.",
      "gridPos": {
        "h": 11,
        "w": 13,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Down",
                        "color": "red",
                        "index": 0
                      },
                      "0.5": {
                        "text": "Alerting",
                        "color": "orange",
                        "index": 1
                      },
                      "1": {
                        "text": "Up",
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "countRows": true,
          "fields": ""
        },
        "sortBy": [
          {
            "desc": false,
            "displayName": "Device"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "device_info{region=~\"$region\", country=~\"$country\", site_id=~\"$site\", source=~\"$source\"}",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "device": "Device",
              "site_id": "Site",
              "region": "Region",
              "country": "Country",
              "priority": "Prio",
              "model": "Model",
              "type": "Type",
              "role": "Role",
              "ident": "Serial / System-IP",
              "source": "Managed By",
              "Value": "Status"
            },
            "indexByName": {
              "site_id": 0,
              "device": 1,
              "role": 2,
              "model": 3,
              "type": 4,
              "source": 5,
              "ident": 6,
              "priority": 7,
              "Value": 8
            }
          }
        }
      ]
    },
    {
